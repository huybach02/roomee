{
  "name": "roomee-backend",
  "version": "1.0.0",
  "description": "Backend API server built with Node.js, Express, and TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "predev": "tsc && cp -r src/locales/. dist/locales/",
    "dev": "node scripts/dev.mjs",
    "build": "tsc && cp -r src/locales/. dist/locales/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/config/data-source.ts",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "node scripts/migration-generate.mjs",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/config/data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/data-source.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/config/data-source.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/config/data-source.js",
    "migration:revert:prod": "node ./node_modules/typeorm/cli.js migration:revert -d dist/config/data-source.js",
    "migration:show:prod": "node ./node_modules/typeorm/cli.js migration:show -d dist/config/data-source.js",
    "seed": "tsx src/commands/seeder.ts",
    "seed:prod": "node dist/commands/seeder.js",
    "clean:redis": "tsx src/commands/cleanExpiredRedis.ts",
    "clean:redis:prod": "node dist/commands/cleanExpiredRedis.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript"
  ],
  "dependencies": {
    "argon2": "^0.45.1",
    "bullmq": "^6.4.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "install": "^0.13.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.6",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "ts-mixer": "^6.0.4",
    "tsyringe": "^4.10.0",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
