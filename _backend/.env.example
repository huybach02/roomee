PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Trust Proxy (1, true, false, hoặc subnet/IP của proxy. Mặc định: 1)
TRUST_PROXY=1

DATABASE_URL=

# redis://user:password@host:port/db (dùng rediss:// nếu bật TLS)
REDIS_URL=

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Roomee <your_email@gmail.com>"